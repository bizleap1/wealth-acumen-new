# Wealth Acumen - Lead & Email Notification Configuration
# Set the email address where lead alerts should be received
OWNER_EMAIL=info@wealthacumen.in

# ==============================================================================
# SMTP Configuration (Configure to enable live email delivery)
# Compatible with Gmail, Zoho, Hostinger, SendGrid SMTP, Amazon SES, Brevo, etc.
# ==============================================================================
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM="Wealth Acumen Leads" <info@wealthacumen.in>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wealth Acumen Leads" <info@wealthacumen.in>

# ==============================================================================
# Alternative HTTP API Services (Optional)
# ==============================================================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxx
